{
  "folders": [
    { "path": ".", "name": "Root" },
    { "path": "apps/mobile", "name": "📱 Mobile (Flutter)" },
    { "path": "apps/api", "name": "🔧 API (NestJS)" },
    { "path": "apps/admin-web", "name": "🖥️ Admin (Next.js)" },
    { "path": "apps/realtime-gateway", "name": "⚡ Realtime" },
    { "path": "packages/db", "name": "💾 Database" },
    { "path": "packages/design-system", "name": "🎨 Design System" },
    { "path": "test-env", "name": "🧪 Test Environment" }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "[dart]": { "editor.defaultFormatter": "Dart-Code.dart-code", "editor.formatOnSave": true, "editor.selectionHighlight": false, "editor.suggest.snippetsPreventQuickSuggestions": false, "editor.suggestSelection": "first", "editor.tabCompletion": "onlySnippets", "editor.wordBasedSuggestions": "off" },
    "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[prisma]": { "editor.defaultFormatter": "Prisma.prisma" },
    "dart.flutterSdkPath": "C:\\Programs\\flutter",
    "dart.lineLength": 120,
    "typescript.preferences.importModuleSpecifier": "relative",
    "tailwindCSS.experimental.classRegex": ["clsx\\(([^)]*)\\)"],
    "files.associations": { "*.arb": "json" },
    "search.exclude": { "**/node_modules": true, "**/dist": true, "**/.next": true, "**/build": true, "**/.dart_tool": true }
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Flutter: Mobile App",
        "type": "dart",
        "request": "launch",
        "program": "apps/mobile/lib/main.dart",
        "cwd": "${workspaceFolder}/apps/mobile",
        "args": ["--dart-define=API_URL=http://10.0.2.2:3000/v1", "--dart-define=WS_URL=ws://10.0.2.2:3001"]
      },
      {
        "name": "Flutter: Mobile (Chrome)",
        "type": "dart",
        "request": "launch",
        "program": "apps/mobile/lib/main.dart",
        "cwd": "${workspaceFolder}/apps/mobile",
        "args": ["--dart-define=API_URL=http://localhost:3000/v1", "--dart-define=WS_URL=ws://localhost:3001", "-d", "chrome"]
      },
      {
        "name": "Flutter: Android",
        "type": "dart",
        "request": "launch",
        "program": "apps/mobile/lib/main.dart",
        "cwd": "${workspaceFolder}/apps/mobile",
        "args": ["--dart-define=API_URL=http://10.0.2.2:3000/v1", "-d", "android"]
      },
      {
        "name": "Flutter: iOS Simulator",
        "type": "dart",
        "request": "launch",
        "program": "apps/mobile/lib/main.dart",
        "cwd": "${workspaceFolder}/apps/mobile",
        "args": ["--dart-define=API_URL=http://localhost:3000/v1", "-d", "ios"]
      },
      {
        "name": "Flutter: Windows (Desktop)",
        "type": "dart",
        "request": "launch",
        "program": "apps/mobile/lib/main.dart",
        "cwd": "${workspaceFolder}/apps/mobile",
        "args": ["--dart-define=API_URL=http://localhost:3000/v1", "-d", "windows"]
      },
      {
        "name": "Flutter: Web (Chrome)",
        "type": "dart",
        "request": "launch",
        "program": "apps/mobile/lib/main.dart",
        "cwd": "${workspaceFolder}/apps/mobile",
        "args": ["--dart-define=API_URL=http://localhost:3000/v1", "--dart-define=WS_URL=ws://localhost:3001", "-d", "chrome", "--web-renderer", "canvaskit"]
      },
      {
        "name": "NestJS: API (Debug)",
        "type": "node",
        "request": "launch",
        "runtimeArgs": ["--napi-modules", "node_modules/@nestjs/cli/bin/nest.js", "start", "--debug", "--watch"],
        "cwd": "${workspaceFolder}/apps/api",
        "console": "integratedTerminal",
        "envFile": "${workspaceFolder}/.env"
      },
      {
        "name": "Next.js: Admin Web",
        "type": "node",
        "request": "launch",
        "runtimeExecutable": "npm",
        "runtimeArgs": ["run", "dev"],
        "cwd": "${workspaceFolder}/apps/admin-web",
        "console": "integratedTerminal"
      },
      {
        "name": "Test: API (91 tests)",
        "type": "node",
        "request": "launch",
        "program": "${workspaceFolder}/test-env/test-runner.js",
        "console": "integratedTerminal",
        "preLaunchTask": "start-test-server"
      },
      {
        "name": "Test: Flutter Unit",
        "type": "dart",
        "request": "launch",
        "program": "apps/mobile/test/",
        "cwd": "${workspaceFolder}/apps/mobile"
      }
    ],
    "compounds": [
      {
        "name": "Full Stack (API + Admin + Realtime)",
        "configurations": ["NestJS: API (Debug)", "Next.js: Admin Web"]
      }
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      { "label": "start-test-server", "type": "shell", "command": "node test-env/server.js", "isBackground": true, "problemMatcher": [] },
      { "label": "docker-up", "type": "shell", "command": "docker compose up -d" },
      { "label": "docker-down", "type": "shell", "command": "docker compose down" },
      { "label": "db-migrate", "type": "shell", "command": "make prisma-migrate" },
      { "label": "db-seed", "type": "shell", "command": "make db-seed" },
      { "label": "prisma-studio", "type": "shell", "command": "cd apps/api && npx prisma studio" },
      { "label": "flutter-clean", "type": "shell", "command": "cd apps/mobile && flutter clean && flutter pub get" }
    ]
  },
  "extensions": {
    "recommendations": [
      "Dart-Code.dart-code",
      "Dart-Code.flutter",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "bradlc.vscode-tailwindcss",
      "Prisma.prisma",
      "ms-azuretools.vscode-docker",
      "humao.rest-client",
      "ms-vscode.vscode-typescript-next",
      "GraphQL.vscode-graphql"
    ]
  }
}
