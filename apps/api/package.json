{
  "name": "@lahloba/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./testing": "./src/testing.ts",
    "./db": "./src/db.ts",
    "./migrator": "./src/migrator.ts",
    "./sweep": "./src/orders/fulfilment.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx src/cli/migrate.ts up",
    "db:rollback": "tsx src/cli/migrate.ts down",
    "db:status": "tsx src/cli/migrate.ts status",
    "db:seed:dev": "tsx src/cli/seedDev.ts",
    "ops:grant:dev": "tsx src/cli/grantOpsDev.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "11.2.1",
    "@lahloba/config": "workspace:*",
    "@lahloba/contracts": "workspace:*",
    "@lahloba/domain": "workspace:*",
    "@vercel/blob": "2.8.2",
    "fastify": "5.12.7",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
