generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleType {
  CUSTOMER
  CHEF
  STORE
  DELIVERY
  ADMIN
}

enum OrderStatus {
  CREATED
  CONFIRMED
  INGREDIENTS_SOURCING
  INGREDIENTS_DELIVERED_TO_CHEF
  CHEF_PREPARING
  MEAL_READY
  MEAL_ON_THE_WAY
  DELIVERED
  CANCELLED
}

enum IngredientSource {
  CHEF
  STORES
}

enum ComboMode {
  CHEAPEST
  FASTEST
}

enum DeliveryTaskType {
  INGREDIENT_RUN
  MEAL_RUN
}

enum DeliveryTaskStatus {
  AVAILABLE
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum RefundType {
  PARTIAL
  FULL
}

enum ChatMessageType {
  TEXT
  IMAGE
  SYSTEM
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model User {
  userId String @id @map("user_id")
  role RoleType
  phone String? @unique
  email String? @unique
  name String?
  avatarUrl String? @map("avatar_url")
  locale String @default("en")
  ratingAvg Decimal? @default(0) @map("rating_avg") @db.Decimal(3,2)
  isActive Boolean @default(true) @map("is_active")
  pushToken String? @map("push_token")
  devicePlatform String? @map("device_platform")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  addresses Address[]
  chefProfile ChefProfile?
  storeProfile StoreProfile?
  customerOrders Order[] @relation("CustomerOrders")
  chefOrders Order[] @relation("ChefOrders")
  deliveryTasks DeliveryTask[]
  chatParts ChatParticipant[]
  chatMessages ChatMessage[]
  payouts Payout[]
  createdTickets SupportTicket[] @relation("TicketCreator")
  assignedTickets SupportTicket[] @relation("TicketAssignee")
  ratings Rating[]
  @@index([role])
  @@map("users")
}

model Address {
  addressId String @id @map("address_id")
  userId String @map("user_id")
  label String @default("Home")
  line1 String
  line2 String?
  city String
  region String
  lat Float
  lng Float
  notes String?
  isDefault Boolean @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)
  orders Order[]
  storeProfile StoreProfile?
  @@index([userId])
  @@map("addresses")
}

model ChefProfile {
  chefId String @id @map("chef_id")
  bio String?
  hygieneScore Decimal? @default(0) @map("hygiene_score") @db.Decimal(3,2)
  maxConcurrent Int @default(3) @map("max_concurrent")
  isAvailable Boolean @default(true) @map("is_available")
  zoneId String? @map("zone_id")
  user User @relation(fields: [chefId], references: [userId], onDelete: Cascade)
  meals Meal[]
  @@map("chef_profiles")
}

model Ingredient {
  ingredientId String @id @map("ingredient_id")
  nameEn String @map("name_en")
  nameAr String @map("name_ar")
  unit String
  category String?
  imageUrl String? @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")
  mealIngredients MealIngredient[]
  productMaps ProductIngredientMap[]
  @@map("ingredients")
}

model Meal {
  mealId String @id @map("meal_id")
  chefId String @map("chef_id")
  nameEn String @map("name_en")
  nameAr String @map("name_ar")
  descriptionEn String? @map("description_en")
  descriptionAr String? @map("description_ar")
  type String
  basePriceMinor BigInt @map("base_price_minor")
  prepTimeMin Int @default(30) @map("prep_time_min")
  allergens String[] @default([])
  imageUrl String? @map("image_url")
  isActive Boolean @default(true) @map("is_active")
  ratingAvg Decimal? @default(0) @map("rating_avg") @db.Decimal(3,2)
  orderCount Int @default(0) @map("order_count")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  chef ChefProfile @relation(fields: [chefId], references: [chefId])
  mealIngredients MealIngredient[]
  orders Order[]
  @@index([chefId])
  @@map("meals")
}

model MealIngredient {
  mealId String @map("meal_id")
  ingredientId String @map("ingredient_id")
  qty Decimal @db.Decimal(10,3)
  unit String
  isOptional Boolean @default(false) @map("is_optional")
  meal Meal @relation(fields: [mealId], references: [mealId], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [ingredientId])
  @@id([mealId, ingredientId])
  @@map("meal_ingredients")
}

model StoreProfile {
  storeId String @id @map("store_id")
  nameEn String @map("name_en")
  nameAr String @map("name_ar")
  addressId String? @unique @map("address_id")
  zoneId String? @map("zone_id")
  acceptanceRate Decimal? @default(100) @map("acceptance_rate") @db.Decimal(5,2)
  avgPackMin Int @default(15) @map("avg_pack_min")
  user User @relation(fields: [storeId], references: [userId], onDelete: Cascade)
  address Address? @relation(fields: [addressId], references: [addressId])
  products StoreProduct[]
  fulfillments StoreFulfillment[]
  @@map("store_profiles")
}

model StoreProduct {
  productId String @id @map("product_id")
  storeId String @map("store_id")
  nameEn String @map("name_en")
  nameAr String @map("name_ar")
  priceMinor BigInt @map("price_minor")
  unit String
  inStock Boolean @default(true) @map("in_stock")
  imageUrl String? @map("image_url")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  store StoreProfile @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  ingredientMaps ProductIngredientMap[]
  fulfillmentLines StoreFulfillmentLine[]
  @@index([storeId])
  @@map("store_products")
}

model ProductIngredientMap {
  productId String @map("product_id")
  ingredientId String @map("ingredient_id")
  unitFactor Decimal @default(1) @map("unit_factor") @db.Decimal(10,3)
  product StoreProduct @relation(fields: [productId], references: [productId], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [ingredientId], onDelete: Cascade)
  @@id([productId, ingredientId])
  @@map("product_ingredient_map")
}

model Order {
  orderId String @id @map("order_id")
  customerId String @map("customer_id")
  chefId String @map("chef_id")
  mealId String @map("meal_id")
  servings Int
  ingredientSource IngredientSource @map("ingredient_source")
  ingredientComboMode ComboMode? @map("ingredient_combo_mode")
  comboId String? @map("combo_id")
  scheduledAt DateTime @map("scheduled_at")
  addressId String @map("address_id")
  notesToChef String? @map("notes_to_chef")
  pricing Json
  status OrderStatus @default(CREATED)
  orderVersion Int @default(1) @map("order_version")
  idempotencyKey String? @unique @map("idempotency_key")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  customer User @relation("CustomerOrders", fields: [customerId], references: [userId])
  chef User @relation("ChefOrders", fields: [chefId], references: [userId])
  meal Meal @relation(fields: [mealId], references: [mealId])
  address Address @relation(fields: [addressId], references: [addressId])
  fulfillments StoreFulfillment[]
  deliveryTasks DeliveryTask[]
  chatRoom ChatRoom?
  payments Payment[]
  refunds Refund[]
  tickets SupportTicket[]
  ratings Rating[]
  @@index([customerId])
  @@index([status])
  @@map("orders")
}

model StoreFulfillment {
  storeFulfillmentId String @id @map("store_fulfillment_id")
  orderId String @map("order_id")
  storeId String @map("store_id")
  status String @default("PACKING")
  subtotalMinor BigInt @map("subtotal_minor")
  pickupWindowStart DateTime? @map("pickup_window_start")
  pickupWindowEnd DateTime? @map("pickup_window_end")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  store StoreProfile @relation(fields: [storeId], references: [storeId])
  lines StoreFulfillmentLine[]
  substitutions Substitution[]
  @@index([orderId])
  @@map("store_fulfillments")
}

model StoreFulfillmentLine {
  lineId String @id @map("line_id")
  storeFulfillmentId String @map("store_fulfillment_id")
  ingredientId String? @map("ingredient_id")
  productId String? @map("product_id")
  qty Decimal @db.Decimal(10,3)
  unit String
  lineTotalMinor BigInt @map("line_total_minor")
  substitutionStatus String @default("NONE") @map("substitution_status")
  fulfillment StoreFulfillment @relation(fields: [storeFulfillmentId], references: [storeFulfillmentId], onDelete: Cascade)
  product StoreProduct? @relation(fields: [productId], references: [productId])
  @@map("store_fulfillment_lines")
}

model Substitution {
  substitutionId String @id @map("substitution_id")
  storeFulfillmentId String @map("store_fulfillment_id")
  lineId String @map("line_id")
  original Json
  proposed Json
  priceDiffMinor BigInt @default(0) @map("price_diff_minor")
  customerApproval String @default("PENDING") @map("customer_approval")
  chefApproval String @default("PENDING") @map("chef_approval")
  finalStatus String? @map("final_status")
  finalizedAt DateTime? @map("finalized_at")
  fulfillment StoreFulfillment @relation(fields: [storeFulfillmentId], references: [storeFulfillmentId], onDelete: Cascade)
  @@map("substitutions")
}

model DeliveryTask {
  taskId String @id @map("task_id")
  orderId String @map("order_id")
  taskType DeliveryTaskType @map("task_type")
  status DeliveryTaskStatus @default(AVAILABLE)
  payoutMinor BigInt @map("payout_minor")
  stopCount Int @map("stop_count")
  assignedTo String? @map("assigned_to")
  scheduledStart DateTime? @map("scheduled_start")
  scheduledEnd DateTime? @map("scheduled_end")
  distanceKm Decimal? @map("distance_km") @db.Decimal(10,2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  driver User? @relation(fields: [assignedTo], references: [userId])
  stops DeliveryStop[]
  @@index([orderId])
  @@index([status])
  @@map("delivery_tasks")
}

model DeliveryStop {
  stopId String @id @map("stop_id")
  taskId String @map("task_id")
  stopType String @map("stop_type")
  stopRefId String @map("stop_ref_id")
  sequence Int
  otpHash String? @map("otp_hash")
  otpExpiresAt DateTime? @map("otp_expires_at")
  confirmedAt DateTime? @map("confirmed_at")
  confirmationType String? @map("confirmation_type")
  lat Float?
  lng Float?
  task DeliveryTask @relation(fields: [taskId], references: [taskId], onDelete: Cascade)
  @@index([taskId, sequence])
  @@map("delivery_stops")
}

model ChatRoom {
  chatRoomId String @id @map("chat_room_id")
  orderId String? @unique @map("order_id")
  createdAt DateTime @default(now()) @map("created_at")
  order Order? @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  participants ChatParticipant[]
  messages ChatMessage[]
  @@map("chat_rooms")
}

model ChatParticipant {
  chatRoomId String @map("chat_room_id")
  userId String @map("user_id")
  role RoleType
  joinedAt DateTime @default(now()) @map("joined_at")
  room ChatRoom @relation(fields: [chatRoomId], references: [chatRoomId], onDelete: Cascade)
  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)
  @@id([chatRoomId, userId])
  @@map("chat_participants")
}

model ChatMessage {
  messageId String @id @map("message_id")
  chatRoomId String @map("chat_room_id")
  senderId String @map("sender_id")
  senderRole RoleType @map("sender_role")
  messageType ChatMessageType @default(TEXT) @map("message_type")
  text String?
  attachments Json?
  cardPayload Json? @map("card_payload")
  createdAt DateTime @default(now()) @map("created_at")
  room ChatRoom @relation(fields: [chatRoomId], references: [chatRoomId], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [userId])
  @@index([chatRoomId, createdAt])
  @@map("chat_messages")
}

model Payment {
  paymentId String @id @map("payment_id")
  orderId String @map("order_id")
  provider String @default("stub")
  method String
  status PaymentStatus @default(PENDING)
  providerRef String? @map("provider_ref")
  amountMinor BigInt @map("amount_minor")
  currency String @default("EGP")
  idempotencyKey String? @unique @map("idempotency_key")
  paidAt DateTime? @map("paid_at")
  createdAt DateTime @default(now()) @map("created_at")
  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  @@index([orderId])
  @@map("payments")
}

model Refund {
  refundId String @id @map("refund_id")
  orderId String @map("order_id")
  paymentId String? @map("payment_id")
  refundType RefundType @map("refund_type")
  amountMinor BigInt @map("amount_minor")
  components Json
  reasonCode String @map("reason_code")
  notes String?
  refundedAt DateTime @default(now()) @map("refunded_at")
  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  @@map("refunds")
}

model Payout {
  payoutId String @id @map("payout_id")
  partyRole RoleType @map("party_role")
  partyId String @map("party_id")
  amountMinor BigInt @map("amount_minor")
  currency String @default("EGP")
  periodFrom DateTime @map("period_from")
  periodTo DateTime @map("period_to")
  status String @default("PENDING")
  completedAt DateTime? @map("completed_at")
  createdAt DateTime @default(now()) @map("created_at")
  party User @relation(fields: [partyId], references: [userId])
  @@index([partyId])
  @@map("payouts")
}

model SupportTicket {
  ticketId String @id @map("ticket_id")
  orderId String @map("order_id")
  createdById String @map("created_by_id")
  category String
  message String
  evidenceUrls String[] @default([]) @map("evidence_urls")
  status TicketStatus @default(OPEN)
  assignedTo String? @map("assigned_to")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  creator User @relation("TicketCreator", fields: [createdById], references: [userId])
  assignee User? @relation("TicketAssignee", fields: [assignedTo], references: [userId])
  @@index([orderId])
  @@map("support_tickets")
}

model Rating {
  ratingId String @id @map("rating_id")
  orderId String @map("order_id")
  customerId String @map("customer_id")
  chefScore Int? @map("chef_score")
  deliveryScore Int? @map("delivery_score")
  mealScore Int? @map("meal_score")
  comment String?
  createdAt DateTime @default(now()) @map("created_at")
  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  customer User @relation(fields: [customerId], references: [userId])
  @@index([orderId])
  @@map("ratings")
}

model OutboxEvent {
  id String @id
  type String
  version String @default("1.0")
  createdAt DateTime @default(now()) @map("created_at")
  tenant String @default("EG")
  environment String @default("production")
  correlationId String? @map("correlation_id")
  actor Json?
  data Json
  status String @default("PENDING")
  retryCount Int @default(0) @map("retry_count")
  lastError String? @map("last_error")
  @@index([status, createdAt])
  @@map("outbox_events")
}
