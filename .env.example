# ══════════════════════════════════════════════════
#  LAHLOBA — Environment Configuration
#  Copy to .env: cp .env.example .env
# ══════════════════════════════════════════════════

# ── Database (PostgreSQL 16) ──
DATABASE_URL=postgresql://lahloba:lahloba_secret@localhost:5432/lahloba

# ── Cache & Pub/Sub (Redis 7) ──
REDIS_URL=redis://localhost:6379

# ── Event Streaming (Kafka) ──
KAFKA_BROKERS=localhost:9092

# ── Auth ──
JWT_SECRET=change-me-in-production-min-32-chars!!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300

# ── Object Storage (MinIO / S3) ──
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=lahloba-media
S3_REGION=us-east-1

# ── Push Notifications ──
# FCM (Android)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_KEY=

# APNs (iOS)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=

# ── Payments (Stub for dev) ──
PAYMENT_PROVIDER=stub
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# ── App Ports ──
API_PORT=3000
WS_PORT=3001
ADMIN_PORT=3002
NODE_ENV=development
LOG_LEVEL=debug

# ── CORS ──
CORS_ORIGINS=http://localhost:3002,http://localhost:8080,http://localhost:3000

# ── Push Decision Engine ──
PUSH_THROTTLE_TTL_SECONDS=90
PUSH_BURST_THRESHOLD=3
PUSH_DEDUPE_TTL_HOURS=24
PUSH_SUPPRESS_TTL_SECONDS=90
WS_PRESENCE_TTL_SECONDS=70
APP_FOREGROUND_TTL_SECONDS=90

# ── Search (Meilisearch) ──
MEILI_URL=http://localhost:7700
MEILI_KEY=masterKey

# ── Email (MailHog for dev) ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
