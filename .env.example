# Lahloba example environment. PLACEHOLDERS ONLY — never commit real secrets.
# Copy to .env for local development. Staging/production values come from a secrets manager.

# development | test | staging | production
LAHLOBA_ENV=development

# Disposable local database for development. Use a least-privileged role in staging/production.
DATABASE_URL=postgres://lahloba_dev:CHANGE_ME@127.0.0.1:5432/lahloba_dev

API_HOST=127.0.0.1
API_PORT=4000
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:5173

# Identity: "oidc" (real provider) or "dev-stub" (development/test ONLY).
IDENTITY_PROVIDER=dev-stub
# Must be exactly "true" to enable the dev stub. Ignored/forbidden outside development/test.
LAHLOBA_DEV_IDENTITY_STUB=true
# At least 32 characters. Local development only.
DEV_STUB_SIGNING_SECRET=replace-with-32+-random-characters-for-local-dev

# Required when IDENTITY_PROVIDER=oidc
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# Evidence storage: "disabled", "local-disk" (development/test), or "vercel-blob" (private store;
# needs BLOB_READ_WRITE_TOKEN or Vercel OIDC). "dev-metadata-only" records references only.
EVIDENCE_STORAGE=local-disk
STORAGE_LOCAL_DIR=.lahloba-evidence
STORAGE_SIGNING_SECRET=change-me-local-only-32-characters-min
# Base URL used in reviewer file links (optional locally).
PUBLIC_API_URL=

# Payments: "disabled" or "simulator" (SANDBOX, no real money; refused when LAHLOBA_ENV=production).
PAYMENTS_PROVIDER=simulator
PAYMENTS_SIMULATOR_SECRET=change-me-local-only-32-characters-min
# Ordering derives courier handoff codes from this secret (codes are never stored in plaintext).
HANDOFF_CODE_SECRET=change-me-local-only-32-characters-min
# Protects the scheduled sweep endpoint (expiries, deadlines). Vercel Cron sends it as a bearer token.
CRON_SECRET=

# Clerk (IDENTITY_PROVIDER=clerk). The publishable key is public; no Clerk secret key is needed.
CLERK_PUBLISHABLE_KEY=
CLERK_AUTHORIZED_PARTIES=

# Worker
WORKER_POLL_INTERVAL_MS=2000
WORKER_MAX_ATTEMPTS=8

# Client apps (public, bundled into the app — never put secrets in EXPO_PUBLIC_* or VITE_*)
EXPO_PUBLIC_API_URL=http://127.0.0.1:4000
EXPO_PUBLIC_DEV_IDENTITY_STUB=true
VITE_API_URL=http://127.0.0.1:4000
VITE_DEV_IDENTITY_STUB=true
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
